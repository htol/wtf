{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "wtf",
	"version": "0.1.0",
	"identifier": "local.wtf.app",
	"app": {
		"windows": [
			{
				"label": "overlay",
				"title": "wtf-overlay",
				"url": "overlay.html",
				"width": 260,
				"height": 30,
				"visible": false,
				"decorations": false,
				"transparent": true,
				"shadow": false,
				"alwaysOnTop": true,
				"skipTaskbar": true,
				"resizable": true,
				"focus": false
			},
			{
				"label": "main",
				"title": "wtf",
				"width": 760,
				"height": 540,
				"visible": true,
				"decorations": false
			}
		],
		"security": {
			"csp": null
		}
	},
	"build": {
		"beforeDevCommand": "npm run dev",
		"devUrl": "http://localhost:5173",
		"beforeBuildCommand": "npm run build",
		"frontendDist": "../dist"
	},
	"bundle": {
		"active": false
	}
}
