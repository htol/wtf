{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"isolatedModules": true,
		"resolveJsonModule": true,
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"types": ["vite/client"],
		"verbatimModuleSyntax": true
	},
	"include": ["src/**/*.ts", "src/**/*.svelte"]
}
