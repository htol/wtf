[Unit]
Description=wtf - local voice-to-text dictation
PartOf=graphical-session.target
After=graphical-session.target

[Service]
# NVIDIA proprietary driver: see README "NVIDIA note" for the drop-in.
ExecStart=%h/.local/bin/wtf
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
