[Unit]
Description=wtf - local voice-to-text dictation
PartOf=graphical-session.target
After=graphical-session.target

[Service]
# NVIDIA proprietary driver + WebKitGTK on Wayland: the DMA-BUF renderer
# raises Wayland protocol errors (Error 71). See README "NVIDIA note".
Environment=WEBKIT_DISABLE_DMABUF_RENDERER=1
ExecStart=%h/.local/bin/wtf
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
