<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>@LABEL@</string>
	<!-- `make enable` fills in @LABEL@ (app identifier + ".autostart") and
	     @APP@ (the installed bundle path). -->
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/open</string>
		<string>@APP@</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
</dict>
</plist>
